# Allowlist: ignore everything, then publish only the site's own files.
# To publish a new top-level file or folder, add a "!/name" line here on purpose.
/*
!/.gitignore
!/.nojekyll
!/README.md
!/index.html
!/404.html
!/robots.txt
!/sitemap.xml
!/assets/
!/what-we-do/
!/hospitals/
!/leadership/
!/about/
!/contact/
!/privacy/
!/updates/
# Un-comment when whitesagehealth.com is pointed at GitHub Pages (see NOTES.md Open items, "Domain day"):
# !/CNAME
